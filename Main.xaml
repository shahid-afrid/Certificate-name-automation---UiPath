                    <ui:InvokeCode.Code>
                      <x:String xml:space="preserve">string tp = templatePathVar;
string nm = nameVar;
string op = outputPathVar;
int xv = int.Parse(xStr);
int yv = int.Parse(yStr);
int fs = int.Parse(fontStr);
string col = colorStr.Trim().ToLower();
string ff = fontFamilyVar.Trim();
int cn = certNumberVar;
bool pdf = isPdfVar;
System.Drawing.Brush textBrush;
if (col == "white") textBrush = System.Drawing.Brushes.White;
else if (col == "red") textBrush = System.Drawing.Brushes.Red;
else if (col == "blue") textBrush = System.Drawing.Brushes.Blue;
else if (col == "gold") textBrush = new System.Drawing.SolidBrush(System.Drawing.Color.Gold);
else if (col == "green") textBrush = new System.Drawing.SolidBrush(System.Drawing.Color.Green);
else if (col == "purple") textBrush = new System.Drawing.SolidBrush(System.Drawing.Color.Purple);
else if (col == "orange") textBrush = new System.Drawing.SolidBrush(System.Drawing.Color.Orange);
else textBrush = System.Drawing.Brushes.Black;
using (System.Drawing.Image img = System.Drawing.Image.FromFile(tp))
{
    using (System.Drawing.Bitmap bmp = new System.Drawing.Bitmap(img))
    {
        using (System.Drawing.Graphics g = System.Drawing.Graphics.FromImage(bmp))
        {
            g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
            g.TextRenderingHint = System.Drawing.Text.TextRenderingHint.AntiAlias;
            using (System.Drawing.Font font = new System.Drawing.Font(ff, fs, System.Drawing.FontStyle.Bold))
            {
                System.Drawing.SizeF ts = g.MeasureString(nm, font);
                float dx = xv;
                float dy = yv;
                g.DrawString(nm, font, textBrush, dx, dy);
            }
            using (System.Drawing.Font numFont = new System.Drawing.Font(ff, 14, System.Drawing.FontStyle.Regular))
            {
                string certNum = "Cert #" + cn.ToString("D3") + " - " + System.DateTime.Now.ToString("MMM yyyy");
                System.Drawing.SizeF numSize = g.MeasureString(certNum, numFont);
                float numX = bmp.Width - numSize.Width - 20;
                float numY = bmp.Height - numSize.Height - 20;
                g.DrawString(certNum, numFont, textBrush, numX, numY);
            }
        }
        if (pdf)
        {
            string pngPath = System.IO.Path.ChangeExtension(op, ".png");
            bmp.Save(pngPath, System.Drawing.Imaging.ImageFormat.Png);
            try
            {
                using (System.Drawing.Printing.PrintDocument pd = new System.Drawing.Printing.PrintDocument())
                {
                    pd.PrinterSettings.PrinterName = "Microsoft Print to PDF";
                    pd.PrinterSettings.PrintToFile = true;
                    pd.PrinterSettings.PrintFileName = op;
                    pd.DefaultPageSettings.PaperSize = new System.Drawing.Printing.PaperSize("Custom", bmp.Width, bmp.Height);
                    pd.DefaultPageSettings.Margins = new System.Drawing.Printing.Margins(0, 0, 0, 0);
                    pd.PrintPage += (sender, e) =&gt; {
                        e.Graphics.DrawImage(bmp, 0, 0);
                        e.HasMorePages = false;
                    };
                    pd.Print();
                }
            }
            catch (System.Exception ex)
            {
                System.Console.WriteLine("PDF conversion failed: " + ex.Message);
            }
        }
        else
