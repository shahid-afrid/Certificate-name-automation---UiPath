    <ui:InvokeCode Language="CSharp" DisplayName="Read Participants File" sap2010:WorkflowViewState.IdRef="InvokeCode_ReadData">
      <ui:InvokeCode.Code>
        <x:String xml:space="preserve">System.Data.DataTable dt = new System.Data.DataTable();
dt.Columns.Add("Name", typeof(string));
dt.Columns.Add("Email", typeof(string));
string ext = System.IO.Path.GetExtension(filePathVar).ToLower();
if (ext == ".csv")
{
    string[] lines = System.IO.File.ReadAllLines(filePathVar);
    for (int i = 1; i &lt; lines.Length; i++)
    {
        string[] parts = lines[i].Split(',');
        if (parts.Length &gt;= 2)
        {
            System.Data.DataRow row = dt.NewRow();
            row["Name"] = parts[0].Trim();
            row["Email"] = parts[1].Trim();
            dt.Rows.Add(row);
        }
    }
}
else
{
    string conn = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + filePathVar + ";Extended Properties='Excel 12.0 Xml;HDR=YES;'";
    if (ext == ".xls")
        conn = "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + filePathVar + ";Extended Properties='Excel 8.0;HDR=YES;'";
    using (System.Data.OleDb.OleDbConnection c = new System.Data.OleDb.OleDbConnection(conn))
    {
        c.Open();
        System.Data.DataTable schema = c.GetOleDbSchemaTable(System.Data.OleDb.OleDbSchemaGuid.Tables, null);
        string sheetName = schema.Rows[0]["TABLE_NAME"].ToString();
        using (System.Data.OleDb.OleDbCommand cmd = new System.Data.OleDb.OleDbCommand("SELECT * FROM [" + sheetName + "]", c))
        {
            using (System.Data.OleDb.OleDbDataReader rdr = cmd.ExecuteReader())
            {
                while (rdr.Read())
                {
                    System.Data.DataRow row = dt.NewRow();
                    row["Name"] = rdr.GetValue(0).ToString();
                    row["Email"] = rdr.GetValue(1).ToString();
                    dt.Rows.Add(row);
                }
            }
        }
    }
}
tableVar = dt;</x:String>
